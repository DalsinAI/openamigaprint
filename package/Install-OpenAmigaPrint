; $VER: Install-OpenAmigaPrint @VERSION@ (@DATE@)
; The Installer script for OpenAmigaPrint (C:Installer / SYS:System/Installer).
; Run it from its icon in the OpenAmigaPrint package drawer.

(set #version "@VERSION@")
(set @app-name "OpenAmigaPrint")

(if (< (/ (getversion) 65536) 39)
    (abort "OpenAmigaPrint needs AmigaOS 3.0 or later."))

(welcome
    (cat "This installs OpenAmigaPrint " #version ".\n\n"
         "OpenAmigaPrint prints from this Amiga to printers on your network that "
         "take PDF (IPP), and saves documents as PDF files. OpenAmigaView opens "
         "pictures and documents and hands them to it."))

(message
    (cat "OpenAmigaPrint will put:\n\n"
         "OpenAmigaPrint, OAPPrinters, OAPDiscover, OpenAmigaView and OAVWorker in C:\n"
         "oapspool.device in DEVS:\n"
         "the OpenAmigaPrint printer driver in DEVS:Printers\n"
         "the spooler in WBStartup, if you want it\n"
         "and an OpenAmigaPrint drawer with OpenAmigaView, Printers and Queue, "
         "a test picture and a test page.\n\n"
         "Files with the same names are replaced."))

(copyfiles
    (prompt "Copying the OpenAmigaPrint commands to C:")
    (help @copyfiles-help)
    (source "C")
    (dest "C:")
    (all)
    (optional "force"))

(copylib
    (prompt "Copying oapspool.device to DEVS:")
    (help @copylib-help)
    (source "Devs/oapspool.device")
    (dest "DEVS:")
    (confirm))

(copyfiles
    (prompt "Copying the OpenAmigaPrint printer driver to DEVS:Printers")
    (help @copyfiles-help)
    (source "Devs/Printers/OpenAmigaPrint")
    (dest "DEVS:Printers")
    (infos)
    (optional "force"))

(if (askbool
        (prompt "Start the OpenAmigaPrint spooler each time Workbench starts?\n\n"
                "It collects what programs print through printer.device and puts it "
                "in the queue for the Print window.")
        (help "Without the spooler, programs that print through printer.device "
              "with OpenAmigaPrint chosen in Prefs/Printer have nothing to collect "
              "their pages. OpenAmigaView and the Print window work either way.")
        (default 1))
    (copyfiles
        (prompt "Copying the spooler to SYS:WBStartup")
        (help @copyfiles-help)
        (source "WBStartup/OAPSpooler")
        (dest "SYS:WBStartup")
        (infos)
        (optional "force")))

(set #where
    (askdir
        (prompt "Where should the OpenAmigaPrint drawer go?\n"
                "(OpenAmigaView, Printers and Queue, and the test files)")
        (help @askdir-help)
        (default "SYS:Utilities")))
(set #drawer (tackon #where "OpenAmigaPrint"))
(makedir #drawer
    (prompt "Making the drawer " #drawer)
    (help @makedir-help))
(copyfiles
    (prompt "Copying the drawer's icon")
    (help @copyfiles-help)
    (source "Icons/OpenAmigaPrint.info")
    (dest #where)
    (optional "force"))
(copyfiles
    (prompt "Copying OpenAmigaView, Printers and Queue and the test files")
    (help @copyfiles-help)
    (source "Drawer")
    (dest #drawer)
    (all)
    (optional "force"))
(set @default-dest #drawer)

(exit
    (cat "OpenAmigaPrint is installed.\n\n"
         "To try it: open the OpenAmigaPrint drawer, double-click Picture.png, "
         "and choose Print... in OpenAmigaView.\n\n"
         "Printers and Queue finds the printers on your network; choose one and "
         "click Use for printing.\n\n"
         "To print from any program: in Prefs/Printer choose the printer type "
         "OpenAmigaPrint, the port \"device\" and oapspool.device unit 0. "
         "The spooler starts with Workbench next time."))
